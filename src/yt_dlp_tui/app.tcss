Screen {
    padding: 1 2;
}

#dest {
    color: $text-muted;
    padding-left: 1;
}

#input-box {
    # Prevent Horizontal container from filling entire vertical space - just wrap the content.
    height: auto;

    border-top: solid $primary;
    border-bottom: solid $primary;
    padding: 0 1;
}

#input-box Static {
    # Prevent Static from filling entire horizontal width as well.
    width: auto;

    padding-right: 1;
}

#input-box Input {
    # Disable default styling from Input.
    border: none;
    padding: 0;
    # Width 1fr = fill remaining horizontal space. Height 1 to keep the input at one row (untested).
    width: 1fr;
    height: 1;
}

#status {
    padding-top: 1;
    padding-bottom: 1;
    # Matches the 2px gutter / padding on FormatPicker's table.
    padding-left: 2;
}

#status.active {
    color: $accent;
}

#status.error {
    color: $error;
}

#status.success {
    color: $success;
}

